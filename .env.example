# ThirdWeb client id — used for wallet connect + as a read fallback.
# Get one at https://thirdweb.com/dashboard. Reads also work via the public RPC below.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=

# Target chain. 84532 = Base Sepolia (testnet, current), 8453 = Base mainnet.
NEXT_PUBLIC_CHAIN_ID=84532

# Optional RPC override for reads. Defaults to a public node for the chain above.
# NEXT_PUBLIC_RPC_URL=https://base-sepolia-rpc.publicnode.com

# First block to scan for governance proposals (governor deploy block).
NEXT_PUBLIC_GOV_FROM_BLOCK=45400000
